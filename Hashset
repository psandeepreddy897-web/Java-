import java.util.HashSet;

public class Illustrate {
    public static void main(String[] args) {
      
        HashSet<String> tags = new HashSet<>();
        
        tags.add("Java");
        tags.add("Python");
        tags.add("C++");
      
        for (String tag : tags) {
            System.out.println(tag);
        }
    }
}
